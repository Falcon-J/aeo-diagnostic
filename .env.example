# AEO Diagnostic - Free API Keys Only
# Copy this file to .env.local and fill in your free-tier keys.

# Google Gemini API - free tier available in Google AI Studio
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# GroqCloud - free tier available, no card required for free usage
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter - free model router
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openrouter/free
# Hugging Face - for enhanced sentiment analysis (optional)
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_...

# Brave Search - for validating real search rankings (optional)
# https://api.search.brave.com/
BRAVE_API_KEY=...

# Optional: Site URL for OpenRouter headers
NEXT_PUBLIC_SITE_URL=http://localhost:3000